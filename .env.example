# ── Сервер ──
# Адрес, на котором слушает HTTP (в контейнере — 0.0.0.0)
HOST=0.0.0.0
# Порт сервера
PORT=3001

# ── Безопасность ──
# Секрет подписи JWT. Минимум 16 символов.
# !! В ПРОДАКЕНЕ ОБЯЗАТЕЛЬНО ЗАМЕНИТЬ на длинный случайный секрет:
#    openssl rand -hex 32
JWT_SECRET=dev-only-jwt-secret-change-me-in-production

# Время жизни access-токена в секундах (по умолчанию сутки, минимум 60)
JWT_TTL_SECONDS=86400

# Окно, в котором ещё можно продлить сессию через refresh после exp
# access-токена (от момента выдачи). Должно быть ≥ JWT_TTL_SECONDS.
# По умолчанию 7 дней.
JWT_REFRESH_MAX_AGE_SECONDS=604800

# Пароль начального администратора (применяется только при первом запуске,
# пока пользователь admin ещё не создан). Минимум 6 символов.
# !! В ПРОДАКЕНЕ ОБЯЗАТЕЛЬНО ЗАМЕНИТЬ на сложный пароль.
ADMIN_PASSWORD=admin123

# ── Шифрование API-ключей провайдеров ──
# Мастер-ключ AES-256-GCM: из него через Argon2id выводится ключ шифрования
# API-ключей LLM/STT/TTS-провайдеров, хранящихся в БД.
# Если не задан — наследуется из JWT_SECRET (достаточно только для dev).
# !! В ПРОДАКЕНЕ ОБЯЗАТЕЛЬНО ЗАДАТЬ ОТДЕЛЬНЫЙ СЛУЧАЙНЫЙ СЕКРЕТ:
#    openssl rand -hex 32
# ВАЖНО: смена ключа делает уже сохранённые API-ключи нечитаемыми
# (их нужно будет ввести заново в админке).
ENCRYPTION_KEY=dev-only-encryption-key-change-me-in-prod

# ── CORS ──
# Разрешённые origin через запятую (только http(s)://…).
# Пусто (или не задано) — Any: удобно в dev, в проде укажите свои домены.
# Пример: ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
# ALLOWED_ORIGINS=

# ── Rate-limit auth (login/register/refresh, по IP) ──
# Максимум запросов на IP в окне. 0 — отключить (тесты/внутренняя сеть).
AUTH_RATE_LIMIT_MAX=20
# Длина окна в секундах (если AUTH_RATE_LIMIT_MAX > 0, то > 0).
AUTH_RATE_LIMIT_WINDOW_SECS=60

# ── Lockout неудачных входов (per-login, хранится в БД) ──
# Неудачных попыток до блокировки учётки. 0 — отключить.
LOGIN_LOCKOUT_MAX_FAILURES=5
# Окно накопления неудач, сек (счётчик сбрасывается после паузы длиннее окна).
LOGIN_LOCKOUT_WINDOW_SECS=900
# Длительность блокировки после превышения лимита, сек.
LOGIN_LOCKOUT_DURATION_SECS=900

# ── Хранилище ──
# Путь к файлу SQLite (родительский каталог должен существовать и быть доступен на запись)
DB_PATH=negotiation_arena.db
# Каталог для скачиваемых локальных моделей (STT/TTS)
MODELS_DIR=models

# ── Логирование ──
# Фильтр tracing: уровень по умолчанию + конкретные крейты
# RUST_LOG=info,axum=info,tower_http=info
