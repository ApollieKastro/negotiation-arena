# ── Сервер ──
HOST=0.0.0.0
PORT=3001

# ── Безопасность ──
# Секрет подписи JWT (минимум 16 символов, обязательно менять в проде)
JWT_SECRET=change_me_to_a_strong_random_secret
# Время жизни токена в секундах (по умолчанию сутки)
JWT_TTL_SECONDS=86400
# Пароль начального администратора (только при первом запуске)
ADMIN_PASSWORD=admin123

# ── Шифрование API-ключей провайдеров ──
# Ключ хранения выводится из этого секрета (Argon2id).
# В проде задавайте отдельный случайный секрет; без него используется JWT_SECRET.
# Сгенерировать: openssl rand -hex 32
# ENCRYPTION_KEY=

# ── Хранилище ──
DB_PATH=negotiation_arena.db
MODELS_DIR=models

# ── Логирование ──
# RUST_LOG=info,axum=info
